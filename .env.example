# ── News Source API Keys (optional — Google News RSS works with no keys) ─────
NEWS_API_KEY=
SERP_API_KEY=
ANTHROPIC_API_KEY=

# ── HubSpot (Account Watch pipeline — src/account_watch_main.py) ─────────────
# No API token needed — the owned-company list comes from a CSV you export
# from HubSpot (Companies view -> filter by owner -> Export) and save as
# owned_accounts.csv (see owned_accounts.example.csv). Re-export on whatever
# cadence you like (e.g. weekly).
# Optional — your HubSpot portal/hub ID, used only to build "View in HubSpot"
# links in the digest email. Find it in Settings -> Account Setup -> Account Defaults.
HUBSPOT_PORTAL_ID=

# ── Supabase (required for dashboard and persistent dedup) ────────────────────
# Create a project at https://app.supabase.com — then run supabase/schema.sql
# in the SQL Editor before first sync.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=  # for sync job / scraper (bypasses RLS)
SUPABASE_KEY=               # anon key for dashboard (read-only via RLS)

# ── Email (Gmail example — use an App Password, not your real password) ──────
EMAIL_SENDER=you@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_RECIPIENTS=you@gmail.com,colleague@company.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Schedule ──────────────────────────────────────────────────────────────────
# every_4_hours (default) | hourly | daily | weekly
RUN_SCHEDULE=every_4_hours
RUN_TIME=07:00

# ── Storage (local fallback if Supabase not configured) ──────────────────────
SEEN_RESULTS_FILE=data/seen_results.json
RESULTS_OUTPUT_FILE=data/results.csv

# ── AI Relevance Filter ───────────────────────────────────────────────────────
USE_AI_FILTER=false
AI_RELEVANCE_THRESHOLD=0.7
